# Sao chép thành file .env rồi chỉnh sửa (file .env KHÔNG commit lên git).
# Mọi giá trị dưới đây đều có mặc định cho môi trường phát triển; khi triển khai thật PHẢI đổi các khóa bí mật.

# Cơ sở dữ liệu PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=123456

# Khóa ký JWT (Base64, >= 256 bit) - dùng chung cho api-gateway và identity-service
JWT_SECRET=5367566B59703373367639792F423F4528482B4D6251655468576D5A71347437

# Khóa nội bộ: các microservice chỉ nhận request có khóa này (đi qua Gateway)
INTERNAL_SECRET=ctut-internal-dev-secret-change-me

# Tài khoản khởi tạo
ADMIN_DEFAULT_PASSWORD=admin
DEMO_USER_PASSWORD=123456
SEED_DEMO_USERS=false
SEED_DEMO_VOUCHERS=false

# Nghiệp vụ
CONTRACT_SIGN_PIN=123456
ORDER_PAYMENT_TIMEOUT_MINUTES=30

# Địa chỉ Gateway mà trình duyệt gọi tới (đổi thành IP máy chủ khi demo qua mạng LAN, VD http://192.168.1.10:8080)
PUBLIC_GATEWAY_URL=http://localhost:8080

# MoMo (mặc định dùng Sandbox)
MOMO_REDIRECT_URL=http://localhost:5173/payment-result
MOMO_IPN_URL=http://localhost:8080/payments/momo-ipn
